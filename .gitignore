# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files（.env.example 只有占位值，要提交）
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user uploads (keep directory via .gitkeep)
/public/uploads/**
!/public/uploads/**/
!/public/uploads/**/.gitkeep

# local verify dev server
/.next-dev/
/prisma/dev-verify.db*

# 本地数据库（含真实数据）与临时产物
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
/tmp/
/screenshots/

# Local Netlify folder
.netlify
.data/

# 本地 HTML 预览构建
/.next-preview/

# 本机运行产物，不进仓库
/tmp/
/.next-*/
/.data/
/.netlify/
/screenshots/
/public/uploads/
*.db
*.db-journal
*.db-wal
*.db-shm
.DS_Store

/apps/web/.next*/
/apps/web/public/uploads/

# Docker 部署的本机配置和备份
/docker/.env
/backups/
# Excalidraw 字体（构建前从 node_modules 复制）
/apps/web/public/excalidraw-assets/

# 任何层级的依赖目录（npm workspace 可能在 apps/web 下装包）
node_modules/
