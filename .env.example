# 复制为 .env 后填写。这里只有占位值，不要把真实密钥提交到仓库。

# 数据库：PostgreSQL 16。本机用 Homebrew（brew install postgresql@16 && brew services start postgresql@16），
# 建库 createdb pm_collab_local，再 npx prisma migrate deploy。
# 开发 / 演示库名带 local、demo、test 等字样；真实数据库叫 pm_collab，db:seed / db:reset 会被保护脚本拒绝。
# 旧的 SQLite 数据用 scripts/migrate-sqlite-to-pg.ts 搬过来（先复制 dev.db，对副本运行）。
DATABASE_URL="postgresql://localhost:5432/pm_collab_local"

# 必填（生产）：至少 32 位，openssl rand -base64 48 生成。缺失或太短时生产环境拒绝启动。
AUTH_SECRET="replace-with-openssl-rand-base64-48"

# 推荐：配置加密专用密钥，至少 32 位。配置后旧密文照常可读，下次保存时自动迁移。设置后不要再改。
# ENCRYPTION_KEY="replace-with-openssl-rand-base64-48"

# 站点对外地址（Origin 校验、机器人消息里的链接、飞书回调）
# APP_URL="https://collab.example.com"

# 可选：第一次安装时直接创建的系统管理员（deploy/setup.sh、Docker 启动时执行；库里已有系统管理员时忽略）。
# 不填就用「首次安装向导」：打开网站会进入 /setup，凭启动日志里的安装码自己创建超级管理员。
# 不填密码会生成随机临时密码，只显示一次；首次登录必须修改。
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# 部署在反向代理后面时设为 1：才会信任 X-Forwarded-For / X-Forwarded-Host。直连时不要设。
# TRUST_PROXY=1

# 部署在 Netlify 时设为 1：proxy 从边缘层的 X-Forwarded-For 取客户端 IP。其他环境不要设。
# TRUST_NETLIFY_IP=1

# Cookie 的 Secure：生产默认开启；只有本机 http 调试才设 false
# COOKIE_SECURE=false

# 飞书（也可在「系统 › 飞书登录」里配置）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=
# FEISHU_AUTO_CREATE=true
# 配置后只有本企业账号能登录，也才允许按个人邮箱绑定已有账号
# FEISHU_TENANT_KEY=

# AI 助手（不配置时用内置规则回答）
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ITR 飞书表格同步（不配则同步接口会报「未配置」；不要提交真实 token / wiki）
# FEISHU_ITR_WIKI_URL=
# FEISHU_ITR_SPREADSHEET_TOKEN=
# FEISHU_ITR_SHEET_ID=
# FEISHU_ITR_SHEET_TITLE=开发计划排期
# FEISHU_ITR_SOURCE_TITLE=开发进度排期表
# FEISHU_USER_ACCESS_TOKEN=

# 头像、项目图标和加密配置的存储位置：local（默认，public/uploads 和 .data）或 s3
# UPLOAD_STORE=local
# 用 S3 / MinIO 时必填 S3_BUCKET，存储桶保持私有。切换前先把已有文件传到存储桶：public/uploads/<目录>/<文件> → uploads/<目录>/<文件>，.data/secure-config.json → config/secure-config
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# 阿里云 OSS 示例（存储桶设为私有；用 RAM 子账号的 AccessKey，只授权这个桶的读写）：
# UPLOAD_STORE=s3
# S3_BUCKET=weavi-space
# S3_REGION=oss-cn-hangzhou
# S3_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com   # 同地域 ECS 用 -internal 内网地址，不收流量费
# S3_FORCE_PATH_STYLE=false                                  # OSS 只支持虚拟主机风格
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 时间一律按服务器系统时区（周报定时等），不需要在这里设置

# 「帮助」面板里的源代码链接（AGPL-3.0 要求向网络用户提供源代码）。部署修改版时指向你自己的仓库；构建时生效
# NEXT_PUBLIC_SOURCE_CODE_URL=https://github.com/Caffrey-Li/weavi-space

# 演示站「以访客身份体验」：设为 1 时登录页出现按钮，一键进入只读演示账号（所有写操作被拒绝）。
# 只给公开演示站用，真实部署不要开。演示企业用 GUEST_DEMO_ORG_CODE 指定企业编码，不填用排序第一的企业。
# GUEST_DEMO=1
# GUEST_DEMO_ORG_CODE=demo


# 需求交付的测试执行（无头浏览器）。默认在 web 进程里跑；设为 worker 时 web 不跑，
# 改由独立进程 `npm run worker:test` 执行（示例 deploy/weavi-test-worker.service），web 重启不会打断测试。
# TEST_RUNNER=worker
# 指定浏览器可执行文件；不设时依次试本机 Chrome、Playwright 自带 Chromium（npx playwright install chromium）
# PM_TEST_BROWSER=
