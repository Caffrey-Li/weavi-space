{
  "name": "pm-collab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "next dev apps/web -p 3100",
    "build": "next build apps/web",
    "start": "next start apps/web -p ${PORT:-3100}",
    "worker:test": "tsx scripts/test-worker.ts",
    "lint": "eslint .",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:from-sqlite": "tsx scripts/migrate-sqlite-to-pg.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/guard-destructive.ts \"db:reset 清空重建数据库\" && prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "sync:itr": "tsx scripts/sync-itr.ts",
    "db:upsert-test-users": "tsx prisma/upsert-test-users.ts",
    "preview:html": "bash scripts/html-preview.sh",
    "test:unit": "vitest run",
    "test:e2e": "bash tests/e2e/run.sh",
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "reset-admin": "tsx scripts/reset-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.8.1",
    "@pm-collab/core": "0.1.0",
    "@pm-collab/db": "0.1.0",
    "@pm-collab/ui": "0.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.59.0",
    "marked": "^16.4.2",
    "next": "16.4.5",
    "nodemailer": "^7.0.13",
    "pg-boss": "^11.1.2",
    "playwright-core": "1.65.0",
    "react": "^19",
    "react-dom": "^19",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "minimatch@>=7 <=11.0.0": "^11.0.1"
  },
  "workspaces": [
    "apps/web",
    "packages/core",
    "packages/db",
    "packages/ui"
  ],
  "license": "AGPL-3.0-only"
}
