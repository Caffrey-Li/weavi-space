# 复制成 docker/.env 再填写；docker/.env 不要提交。
# 生成密钥：openssl rand -base64 48

# PostgreSQL
POSTGRES_PASSWORD=
# POSTGRES_DB=nova_collab
# POSTGRES_USER=nova

# MinIO（S3 兼容存储，也用作应用访问存储桶的账号）
MINIO_ROOT_PASSWORD=
# MINIO_ROOT_USER=nova
# S3_BUCKET=nova-collab

# 应用密钥：都至少 32 位。ENCRYPTION_KEY 设置后不要再改，否则已加密的配置解不开
AUTH_SECRET=
ENCRYPTION_KEY=

# 访问地址（用于跨站校验和通知里的链接）。走 HTTPS 时把 COOKIE_SECURE 改成 true
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# 前面有反向代理（Nginx 等）并会设置 X-Forwarded-For 时改成 1
TRUST_PROXY=0
# WEB_PORT=3000

# 第一次启动时创建的系统管理员（库里已有系统管理员时忽略）。
# 不填密码会生成随机临时密码，只在 web 容器日志里显示一次：docker compose logs web
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
